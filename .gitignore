# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# FEAT-6：正式環境變數範例，隨 repo 版控（只有變數名與用途，零實際值）。
# 沒有這一行時 `.env*` 會把它一起忽略掉——症狀是檔案在工作目錄裡看得到、
# 別人 clone 下來卻沒有，而那正是部署時要照著填的那一份
!/deploy/.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
