// SQLite 軌的 datasource + generator 標頭（開發／MVP 預設）。
// 由 scripts/build-schema.ts 與 prisma/base.prisma 拼接為
// prisma/generated/schema.sqlite.prisma，本檔不得單獨使用。

generator client {
  provider = "prisma-client"
  output   = "../../src/generated/prisma"
}

// Prisma 7.9：datasource.url 不再支援寫在 schema 檔，連線字串一律來自 prisma.config.ts
// （見 prisma.config.ts、research.md R-3a 的修正）
datasource db {
  provider = "sqlite"
}
