# 測試環境的唯一設定來源（隨 repo 版控，見 contracts/env.md §5）
# 只含測試專用值，MUST NOT 放入任何正式環境憑證。
# 注意：本檔 MUST NOT 收錄 DATABASE_PROVIDER 與 DATABASE_URL —— 兩者由 tests/testEnv.ts 的
# loadTestEnv() 依殼層傳入的 DATABASE_PROVIDER 動態決定與覆寫（見該檔）。

TEST_DATABASE_URL_SQLITE="file:./test.db"
TEST_DATABASE_URL_POSTGRES="postgresql://novelsite:novelsite@localhost:5432/novelsite_test"

TRUSTED_PROXY_HOPS=1
SESSION_SECRET="test-only-session-secret-please-change-in-real-env-32bytes+"
SEED_USER_PASSWORD="Test1234"
HEALTH_CHECK_SECRET="test-only-health-check-secret"

# FEAT-4（T003）：本檔未設定 VIEW_HASH_SECRET 會使全部整合測試因啟動期驗證失敗而紅燈，
# 症狀是「環境變數驗證失敗」而非測試斷言失敗，看不出跟這裡有關。
VIEW_HASH_SECRET="test-only-view-hash-secret-fixed-not-rotated-32bytes+"
# 三個排程入口的 Bearer 密鑰。cron-auth 測試需要一個「已設定」的值才能驗
# 「帶錯誤密鑰回 401」；「未設定即拒絕」那一案由測試自行覆寫為 undefined。
CRON_SECRET="test-only-cron-secret"

# FEAT-4（T013）：閱讀歷史上限。正式預設為 500 —— 用那個值驗證「達上限後淘汰最舊者」
# 需要 501 部作品，那不會是一個真的被執行的測試。這裡壓到 3，
# 使上限淘汰成為可負擔的整合案例（tests/integration/reading-history-cap.test.ts）。
READING_HISTORY_MAX=3

# FEAT-5（T001）：測試一律用 memory 實作，零郵件憑證即可啟動（FR-003／SC-010）。
# 整合測試以正式建置產物啟動測試伺服器（NODE_ENV=production），若不顯式指定模式，
# 會退到 production 而撞上「缺 RESEND_API_KEY 即拒絕啟動」——症狀是「環境變數驗證失敗」，
# 看不出跟郵件有關（FR-002b、research R-3）。
MAIL_MODE=memory
# 「寄送確實發生在回應之後」那道測試的**解析度**（research R-6）。
# memory 實作在寫入 outbox 前先等這麼久：同步寄送必然多花 ≥ 300ms，
# 而 after() 生效時兩條路徑的回應時間差 < 200ms。
# 設為 0 會使該測試失去鑑別力——after() 生效與否的天然時間差只有數毫秒。
MAIL_MEMORY_DELAY_MS=300
